  "default_contract": {
    "depth": 4,
    "max_encoded_tlp_bytes": 38,
    "sequence_modulus": 4096,
    "timeout_local_cycles": 1024,
    "max_replays_before_external_recovery": 3,
    "credit": "Exactly one reservation for each original frame; retries preserve encoded bytes and consume no new credit.",
    "ack": "Cumulative modulo window is classified when validated ACK is first presented, with freeing deferred to a packet-safe boundary. Late forward ACK resets retry counter; stale ignored; future ACK rejected.",
    "recovery": "Original plus three retries; next request raises sticky exhaustion/retrain request and retains bytes. External retrain_done allows another replay. Link down resets ownership/sequence.",
    "training": "Timer and new packet scheduling pause; an already started packet completes atomically.",
    "fc": "CRC checked classic VC0 Init1/Init2/Update fields exposed to external controller. No local credit advertisement."
  },
