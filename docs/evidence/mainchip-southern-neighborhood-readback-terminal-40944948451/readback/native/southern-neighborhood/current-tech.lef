    ANTENNACUMAREARATIO 200 ;
    ANTENNACUMDIFFAREARATIO  PWL ( ( 0 200 ) ( 0.159 200 ) ( 0.16 3200 ) ( 100 2e+06 ) ) ;
    DIRECTION HORIZONTAL ;
    RESISTANCE RPERSQ 0.135 ;
    CAPACITANCE CPERSQDIST 3.49e-05 ;
    EDGECAPACITANCE 3.16e-05 ;
END Metal1

