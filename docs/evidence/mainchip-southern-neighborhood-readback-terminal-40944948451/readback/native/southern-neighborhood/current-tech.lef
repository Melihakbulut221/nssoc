LAYER Metal1
    TYPE ROUTING ;
    PITCH 0.42 ;
    WIDTH 0.16 ;
    AREA 0.09 ;
    THICKNESS 0.4 ;
    MAXWIDTH 30 ;
SPACINGTABLE
  PARALLELRUNLENGTH 0.000 1.000 10.000
  WIDTH 0.000	 0.180 0.180 0.180
  WIDTH 0.300	 0.180 0.220 0.220
  WIDTH 10.000	 0.180 0.220 0.600 ;
