    "exact_source_lines": {
      "186": "    assert UI==125e-12 and START==2e-9 and STOP==START+258*UI and STEP==.3125e-12",
      "269": "            delta=v(p)-v(n);signed=[];delays=[]",
      "270": "            for bit,edge in zip(expected,edges,strict=True):",
      "271": "                sign=2*bit-1",
      "272": "                for phase in phases:signed.append(float(np.interp(edge+phase*UI,t,delta))*sign)",
      "273": "                ids=np.flatnonzero((t>=edge)&(t<=edge+.95*UI));bad=ids[delta[ids]*sign<.1]",
      "274": "                delays.append(0. if not len(bad)else float(t[bad[-1]]-edge+STEP))",
      "275": "            return dict(samples=len(signed),minimum_signed_margin_v=min(signed),wrong_sign_samples=sum(x<=0 for x in signed),below_100mv_samples=sum(x<.1 for x in signed),maximum_clock_to_valid_s=max(delays),clock_to_valid_by_bit_s=delays,passed=min(signed)>=.1 and max(delays)<=limit*UI)",
      "276": "        indices=range(1,256);current=[bits[i]for i in indices];previous=[bits[i-1]for i in indices];edge_bits=current if offset<0 else previous",
      "277": "        rising=[START+(i+.5)*UI for i in indices];falling=[START+i*UI for i in indices]",
      "278": "        expected=dict(a=current,b=edge_bits,c=previous,d=edge_bits)",
      "279": "        sampler_checks={tag:measure('xpd.'+tag+'qp','xpd.'+tag+'qn',expected[tag],falling if tag=='b'else rising,(.3,.6,.9),.3)for tag in 'abcd'}",
      "280": "        xbits=[a^b for a,b in zip(current,edge_bits,strict=True)];ybits=[a^b for a,b in zip(previous,edge_bits,strict=True)]",
      "281": "        comparisons=dict(x=measure('xp','xn',xbits,rising,(.6,.75,.9),.6),y=measure('yp','yn',ybits,rising,(.6,.75,.9),.6))",
      "283": "        area=float(np.trapezoid(delta[window],t[window]));average=area/float(t[window][-1]-t[window][0]);direction=1 if offset>0 else-1",
      "284": "        phase_ok=abs(average)<=.01 if constant else direction*average>=.03",
      "287": "            vc,vb,ve,_=map(v,dev['nodes']);ic=d['@q.'+name+'.qnpn13g2[ic]'];checks[name]=dict(minimum_active_vce_v=float((vc-ve)[active].min()),maximum_alltime_abs_vce_v=float(abs(vc-ve).max()),maximum_alltime_abs_vbe_v=float(abs(vb-ve).max()),maximum_alltime_abs_ic_per_emitter_a=float(abs(ic).max()/dev['nx']))",
      "288": "        safe=all(x['minimum_active_vce_v']>=.4 and x['maximum_alltime_abs_vce_v']<=1.6 and x['maximum_alltime_abs_vbe_v']<=1 and x['maximum_alltime_abs_ic_per_emitter_a']<.003 for x in checks.values())",
      "290": "        tails={n:float(d['@q.'+n+'.qnpn13g2[ic]'][active].min())for n in tail_names};safe=safe and min(tails.values())>=.0005",
      "295": "            mos_checks[name]=dict(peaks_v=peaks,limit_v=1.32,minimum_active_vds_v=float((vd-vs)[active].min()),minimum_active_drain_current_a=float(ids[active].min()),maximum_alltime_abs_drain_current_a=float(abs(ids).max()),passed=max(peaks.values())<=1.32 and float((vd-vs)[active].min())>=0)",
      "301": "        stage_tail_currents={key:float(sum((d['@n.'+n+'.nsg13_lv_nmos[ids]']for n in names),np.zeros(len(t)))[active].min())for key,names in bound['mos_tail_groups'].items()}",
      "303": "        safe=safe and all(x['passed']for x in mos_checks.values())and min(mos_tails.values())>=0 and min(stage_tail_currents.values())>=.0005",
      "307": "        cap_checks={name:dict(maximum_alltime_abs_v=float(abs(v(dev['nodes'][0])-v(dev['nodes'][1])).max()),limit_v=1.6)for name,dev in caps.items()};safe=safe and all(x['maximum_alltime_abs_v']<=1.6 for x in cap_checks.values())",
      "308": "        data_ok=all(x['passed']for x in sampler_checks.values())and all(x['passed']for x in comparisons.values())and phase_ok",
      "317": "        vi_phase_ok=(abs(mean_current)<=5e-6 and abs(mean_output)<=.002)if constant else(direction*mean_current>=50e-6 and direction*mean_output>=.005)",
      "318": "        vi_tails={tag:float(ic(tag)[active].min())for tag in ('xtx','xty')}",
      "319": "        vi_bias_ok=min(vi_tails.values())>=.0001",
      "320": "        vi_ok=vi_phase_ok and vi_bias_ok",
      "323": "        assert all(sha(Path(f))==digest for f,digest in protected.items());r['sources_unchanged']=True;r['actual_fault_detected']=fault and not(data_ok and vi_ok)",
      "324": "        passed=r['actual_fault_detected']if fault else safe and data_ok and vi_ok",
      "325": "        r['status']='PASS_WHOLE_MIM_PD500_LOADED_SCREEN_NOT_CLOSED_LOOP_OR_PHY_SIGNOFF'if passed else'REJECTED_WHOLE_MIM_PD500_LOADED'",
      "326": "        assert passed,'Actual whole-wire retimed sampling, loaded phase/current or device gate failed'"
    },
