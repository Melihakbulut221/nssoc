  "prototype_scripts": {
    "prepare_eco10.py": "from pathlib import Path\nimport importlib.util,json,hashlib,re,itertools\nroot=Path.cwd();base=root/'hw/soc/out/external-review-20260919';seed=base/'timing-eco9-buffer-repair';out=base/'timing-eco10-mux-factor';out.mkdir(exist_ok=True)\nspec=importlib.util.spec_from_file_location('eco',root/'hw/soc/flow/check_physical_eco.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);cells,_,_=m.parse(seed/'soc_top.nl.v')\nr=json.loads((seed/'validation-inputs.json').read_text());lib=Path(r['liberty']);assert hashlib.sha256(lib.read_bytes()).hexdigest()==r['liberty_sha256'];lt=lib.read_text();functions={}\ndef function(master):\n if master in functions:return functions[master]\n block=lt.split('cell ('+master+') {',1)[1].split('\\n  cell (',1)[0]\n assert not re.search(r'\\b(ff|latch|three_state|statetable)\\s*[:(]',block)\n f=re.findall(r'function\\s*:\\s*\"([^\"]+)\"',block);assert len(f)==1\n functions[master]=f[0];return f[0]\ndef logic(master,values):\n f=function(master);assert re.fullmatch(r'[\\w\\s!&|()+*]+',f),f\n for token in re.findall(r'\\b[A-Za-z_]\\w*\\b',f):assert token in values,token\n f=re.sub(r'\\b[A-Za-z_]\\w*\\b',lambda x:str(bool(values[x[0]])),f)\n return bool(eval(f.replace('+',' or ').replace('*',' and ').replace('!',' not ').replace('&',' and ').replace('|',' or '),{'__builtins__':{}},{}))\ndrivers={p[k]:(n,master,p) for n,(master,p) in cells.items() for k in ('X','Y','Q') if k in p}\nloads={}\nfor n,(master,p) in cells.items():\n for pin,net in p.items():\n  if pin not in ('X','Y','Q'):loads.setdefault(net,[]).append((n,pin))\ndef rootnet(net):\n seen=set()\n while net in drivers:\n  assert net not in seen;seen.add(net);_,master,p=drivers[net]\n  if not master.startswith(('sg13g2_buf_','sg13g2_dlygate')):break\n  assert function(master).replace(' ','')=='A';net=p['A']\n return net\nchanges=[]\nfor ff,(fm,fp) in cells.items():\n if not re.search(r'u_eth\\.u_mac\\.tx_fifo\\.fifo_inst\\.m_axis_pipe_reg\\[1\\].*\\[\\d+\\]',fp.get('Q','')):continue\n o,om,op=drivers[fp['D']]\n if om!='sg13g2_o21ai_1':\n  print('unchanged endpoint',ff,om);continue\n a,am,ap=drivers[op['A2']]\n if not am.startswith('sg13g2_a21oi_'):\n  print('unchanged endpoint',ff,'buffered AOI',am);continue\n n,nm,np=drivers[ap['B1']];assert nm.startswith('sg13g2_nor2b_')\n assert loads[np['Y']]==[(a,'B1')]\n assert rootnet(np['A'])==rootnet(ap['A1'])\n for sel,lo,hi in itertools.product((False,True),repeat=3):\n  old=logic(am,{'A1':sel,'A2':lo,'B1':logic(nm,{'A':sel,'B_N':hi})})\n  new=logic('sg13g2_inv_4',{'A':logic('sg13g2_mux2_2',{'A0':hi,'A1':lo,'S':sel})})\n  assert old==new\n changes.append({'endpoint':ff,'old_nor':n,'old_aoi':a,'new_mux':n+'_eco_mux','new_inv':a+'_eco_inv','mux_pins':{'A0':np['B_N'],'A1':ap['A2'],'S':ap['A1'],'X':np['Y']},'inv_pins':{'A':np['Y'],'Y':ap['Y']},'select_root':rootnet(np['A'])})\nassert len(changes)>=3,len(changes)\ns=(seed/'eco.tcl').read_text();header=s.split('read_current_odb\\n',1)[0];header+='set ::env(CURRENT_ODB) {'+str(seed/'soc_top.odb')+'}\\nset ::env(STEP_DIR) {'+str(out)+'}\\nforeach key [array names ::env SAVE_*] {unset ::env($key)}\\n'\nfor key,ext in [('ODB','odb'),('DEF','def'),('NL','nl.v'),('PNL','pnl.v'),('SDC','sdc')]:header+='set ::env(SAVE_'+key+') {'+str(out/('soc_top.'+ext))+'}\\n'\nheader+='read_current_odb\\nset_thread_count 4\\nset block [ord::get_db_block]\\n'\nfor c in changes:\n for old,new,master,pins in [(c['old_nor'],c['new_mux'],'sg13g2_mux2_2',c['mux_pins']),(c['old_aoi'],c['new_inv'],'sg13g2_inv_4',c['inv_pins'])]:\n  header+='set old [$block findInst {'+old+'}]\\nset loc [$old getLocation]\\nset orient [$old getOrient]\\nodb::dbInst_destroy $old\\nset new [odb::dbInst_create $block [[ord::get_db] findMaster '+master+'] {'+new+'}]\\n$new setLocation [lindex $loc 0] [lindex $loc 1]\\n$new setOrient $orient\\n$new setPlacementStatus PLACED\\n'\n  for pin,net in pins.items():header+='[$new findITerm '+pin+'] connect [$block findNet {'+net+'}]\\n'\ntail=s[s.index('source $::env(SCRIPTS_DIR)/openroad/common/dpl.tcl'):s.index('puts \"PRE_REPAIR_WNS')]+s[s.index('foreach {corner object}'):]\n(out/'eco.tcl').write_text(header+tail)\nr={'scope':'Isolated unadopted combinational rewrite experiment. Selected TX bank-select NOR/AOI cones become mux2 + inverter, preserving all state. Exhaustive 8-row Boolean check uses actual pinned Liberty expressions and verifies selector roots through positive buffers; full output-netlist delta check and final physical timing still required. Existing restricted sizing checker deliberately does not accept these removed/reconnected cells.','seed':str(seed),'seed_odb_sha256':hashlib.sha256((seed/'soc_top.odb').read_bytes()).hexdigest(),'seed_netlist_sha256':hashlib.sha256((seed/'soc_top.nl.v').read_bytes()).hexdigest(),'liberty':str(lib),'liberty_sha256':hashlib.sha256(lib.read_bytes()).hexdigest(),'functions':functions,'rewrites':changes}\n(out/'inputs.json').write_text(json.dumps(r,indent=2)+'\\n');print('Prepared',len(changes),'rewrites with exhaustive truth-table checks')\n",
    "validate_eco10.py": "from pathlib import Path\nimport importlib.util,json,hashlib,re,itertools\nroot=Path.cwd();d=root/'hw/soc/out/external-review-20260919/timing-eco10-mux-factor';r=json.loads((d/'inputs.json').read_text());seed=Path(r['seed']);sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nassert sha(seed/'soc_top.nl.v')==r['seed_netlist_sha256'];assert sha(r['liberty'])==r['liberty_sha256'];assert sha(seed/'soc_top.odb')==r['seed_odb_sha256']\nspec=importlib.util.spec_from_file_location('eco',root/'hw/soc/flow/check_physical_eco.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);a,ad,aa=m.parse(seed/'soc_top.nl.v');b,bd,ba=m.parse(d/'soc_top.nl.v');assert ad==bd and aa==ba\nremoved={c[k] for c in r['rewrites'] for k in ('old_nor','old_aoi')};added={c[k] for c in r['rewrites'] for k in ('new_mux','new_inv')};assert a.keys()-b.keys()==removed;assert b.keys()-a.keys()==added\nfor n in a.keys()&b.keys():assert a[n]==b[n],n\nfor c in r['rewrites']:\n assert b[c['new_mux']]==('sg13g2_mux2_2',c['mux_pins']);assert b[c['new_inv']]==('sg13g2_inv_4',c['inv_pins'])\noldw={re.sub(r'\\s+',' ',raw.strip()) for raw in (seed/'soc_top.nl.v').read_text().split(';') if re.match(r'^\\s*wire\\b',raw)};neww={re.sub(r'\\s+',' ',raw.strip()) for raw in (d/'soc_top.nl.v').read_text().split(';') if re.match(r'^\\s*wire\\b',raw)};assert oldw==neww\n# Independently extract the pinned library's actual function/direction table.\nlib=Path(r['liberty']).read_text();tables={}\nfor master,expected in r['functions'].items():\n block=lib.split('cell ('+master+') {',1)[1].split('\\n  cell (',1)[0];assert not re.search(r'\\b(ff|latch|three_state|statetable)\\s*[:(]',block)\n f=re.findall(r'function\\s*:\\s*\"([^\"]+)\"',block);assert f==[expected]\n tables[master]=f[0]\ndef value(master,pins):\n f=tables[master];assert re.fullmatch(r'[\\w\\s!&|()+*]+',f)\n f=re.sub(r'\\b[A-Za-z_]\\w*\\b',lambda x:str(bool(pins[x[0]])),f)\n return bool(eval(f.replace('+',' or ').replace('*',' and ').replace('!',' not ').replace('&',' and ').replace('|',' or '),{'__builtins__':{}},{}))\n# Roots and exclusive cone boundaries are re-derived from the input netlist.\ndrivers={p[k]:(n,master,p) for n,(master,p) in a.items() for k in ('X','Y','Q') if k in p};loads={}\nfor n,(_,p) in a.items():\n for k,v in p.items():\n  if k not in ('X','Y','Q'):loads.setdefault(v,[]).append((n,k))\ndef rootnet(net):\n seen=set()\n while net in drivers:\n  assert net not in seen;seen.add(net);_,master,p=drivers[net]\n  if not master.startswith(('sg13g2_buf_','sg13g2_dlygate')):break\n  assert tables[master].replace(' ','')=='A';net=p['A']\n return net\nrows=[]\nfor c in r['rewrites']:\n nm,np=a[c['old_nor']];am,ap=a[c['old_aoi']];assert rootnet(np['A'])==rootnet(ap['A1'])==c['select_root'];assert loads[np['Y']]==[(c['old_aoi'],'B1')]\n assert c['mux_pins']=={'A0':np['B_N'],'A1':ap['A2'],'S':ap['A1'],'X':np['Y']};assert c['inv_pins']=={'A':np['Y'],'Y':ap['Y']}\n for s,l,h in itertools.product((0,1),repeat=3):\n  old=value(am,{'A1':s,'A2':l,'B1':value(nm,{'A':s,'B_N':h})});mux=value('sg13g2_mux2_2',{'S':s,'A1':l,'A0':h});new=value('sg13g2_inv_4',{'A':mux});assert old==new\n  rows.append({'cone':c['old_aoi'],'select':s,'low':l,'high':h,'before':int(old),'after':int(new),'wrong_polarity_negative_control_rejected':old!=mux});assert old!=mux\nresult={'status':'PASS within restricted Boolean scope','scope':'Exact unchanged instances and wires outside nine explicitly bounded stateless cones; exhaustive real-Liberty Boolean equality at all cone inputs and negative polarity controls. Does not prove analog hazards, timing, power-up X semantics, SRAM interiors or final physical signoff.','unchanged_instances':len(a.keys()&b.keys()),'removed_instances':len(removed),'added_instances':len(added),'unchanged_ports_aliases_wire_declarations':True,'truth_table_rows':len(rows),'negative_control_rejections':len(rows),'seed_sha256':sha(seed/'soc_top.nl.v'),'result_sha256':sha(d/'soc_top.nl.v'),'rows':rows}\n(d/'connectivity-logic-check.json').write_text(json.dumps(result,indent=2)+'\\n');print({k:v for k,v in result.items() if k!='rows'})\n"
  },
