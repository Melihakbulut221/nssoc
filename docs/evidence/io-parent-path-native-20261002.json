  "independent_witness_review_source": "from pathlib import Path\nimport hashlib,json,re\nfrom fractions import Fraction\nB=Path(__file__).resolve().parent\nROOT=Path.cwd()\na=json.loads((B/'selected/analysis.json').read_text());s=json.loads((B/'selected/source-reconciliation.json').read_text())\n\ndef parse(raw):\n assert raw.endswith(') props={}') and raw.startswith('(')\n return [[tuple(map(int,point.split(','))) for point in contour.split(';')] for contour in raw[1:-10].split('/')]\n\ndef classify(contour,p):\n x,y=p;hit=False\n for u,v in zip(contour,contour[1:]+contour[:1]):\n  (x1,y1),(x2,y2)=u,v\n  assert x1==x2 or y1==y2\n  if min(x1,x2)<=x<=max(x1,x2) and min(y1,y2)<=y<=max(y1,y2): return 0\n  if (y1>y)!=(y2>y) and x<Fraction((x2-x1)*(y-y1),y2-y1)+x1:hit=not hit\n return 1 if hit else -1\n\ndef inside(contours,p):\n return classify(contours[0],p)==1 and all(classify(c,p)==-1 for c in contours[1:])\n\nsquare=[(0,0),(0,100),(100,100),(100,0)]\nhole=[(20,20),(80,20),(80,80),(20,80)]\nassert inside([square,hole],(10,10)) and not inside([square,hole],(50,50))\nassert not inside([square],(0,50)) and not inside([square],(110,50))\npolys={}\nfor key,w in a['polygon_witnesses'].items():\n assert key==w['layer']+':'+hashlib.sha256(w['polygon'].encode()).hexdigest()\n polys[key]=parse(w['polygon'])\nmetalnums={'metal2_con':10,'metal3_con':30,'metal4_con':50,'metal5_con':67,'topmetal1_con':126}\nvianums={'via2_drw':29,'via3_drw':49,'via4_drw':66,'topvia1_n_cap':125}\nedges={frozenset(v) for v in [('metal2_con','via2_drw'),('via2_drw','metal3_con'),('metal3_con','via3_drw'),('via3_drw','metal4_con'),('metal4_con','via4_drw'),('via4_drw','metal5_con'),('metal5_con','topvia1_n_cap'),('topvia1_n_cap','topmetal1_con')]}\nverified_edges=[]\nfor i,path in enumerate(a['paths']):\n assert inside(polys[path[0]],a['endpoints'][0][1]) and inside(polys[path[-1]],a['endpoints'][i+1][1])\n for left,right in zip(path,path[1:]):\n  l,r=[n.split(':')[0] for n in (left,right)]\n  assert frozenset((l,r)) in edges\n  via=left if l in vianums else right; metal=right if l in vianums else left\n  c=polys[via]; assert len(c)==1 and len(c[0])==4\n  center=tuple(Fraction(sum(p[axis] for p in c[0]),4) for axis in (0,1))\n  assert inside(c,center) and inside(polys[metal],center)\n  verified_edges.append(dict(path=i,layers=[l,r],via_center_dbu=[str(x) for x in center]))\n# Exact transitive derivation dependencies for only the witnessed layers.\ndeps=set()\nfor num in metalnums.values(): deps.update((num,dt) for dt in [0,22,24,29])\ndeps.update((num,0) for num in vianums.values());deps.update([(27,0),(36,0),(129,0)])\nbase=ROOT/'hw/soc/tools/ihp-lvs-5e6d592/ihp-sg13g2/libs.tech/klayout/tech/lvs/rule_decks'\nlayer=(base/'layers_definitions.lvs').read_text();gen=(base/'general_derivations.lvs').read_text();cap=(base/'cap_derivations.lvs').read_text()\nfor full,num in metalnums.items():\n name=full.removesuffix('_con')\n for suffix,dt in [('drw',0),('filler',22),('slit',24),('res',29)]:\n  assert re.search(r'\\b'+name+'_'+suffix+r'\\s*= get_polygons\\('+str(num)+r', '+str(dt)+r'\\)',layer)\n assert name+' = '+name+'_drw.join('+name+'_filler).not('+name+'_slit)' in layer\n expected=name+'.not('+name+'_res)'+('.not(ind_drw)' if name.startswith('top') else '')\n assert re.search(full+r'\\s*= '+re.escape(expected)+r'\\n',gen)\nfor name,num in {'via2_drw':29,'via3_drw':49,'via4_drw':66,'topvia1_drw':125,'ind_drw':27,'mim_drw':36,'vmim_drw':129}.items():\n assert re.search(r'\\b'+name+r'\\s*= get_polygons\\('+str(num)+r', 0\\)',layer)\nassert 'mim_via = vmim_drw.join(topvia1_drw).and(mim_drw)' in cap\nassert 'topvia1_n_cap = topvia1_drw.not(mim_via)' in cap\nconflicts=[]\nfor name,row in s['masters'].items():\n for diff in row['differences']:\n  if tuple(diff['layer']) in deps:conflicts.append([name,diff])\nassert not conflicts\nresult=dict(status='PASS_COMPACT_EXPLICIT_PATH_AND_RESTRICTED_LAYER_DEPENDENCY_CHECK',\n analysis_sha256=hashlib.sha256((B/'selected/analysis.json').read_bytes()).hexdigest(),\n reconciliation_sha256=hashlib.sha256((B/'selected/source-reconciliation.json').read_bytes()).hexdigest(),\n verified_path_edges=len(verified_edges),edge_witnesses=verified_edges,negative_hole_and_boundary_controls=True,\n witnessed_derivation_raw_layer_dependencies=[list(p) for p in sorted(deps)],changed_dependency_layers=conflicts,\n interpretation='The actual physical conductor witness also uses equal source mask geometry in coherent5e6 for the same seven placements. This is a restricted path-geometry inference from exact dependencies, not a native coherent-parent extraction or whole-master equivalence.',\n coherent_parent_native_extraction_performed=False,full_source_identity=False,cell_lvs_accepted=False,manufacturing_approval=False)\n(B/'path-dependency-transfer.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(result['status'],len(verified_edges),len(deps))\n",
