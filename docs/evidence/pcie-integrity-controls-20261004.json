  "rule_summary": "CRC covers sequence/reserved prefix and all TLP bits. First sequence byte carries sequence11:8 in its low nibble; bits enter least-significant first per byte. Normal polynomial04C11DB7, seedFFFFFFFF, complemented remainder and reflected wire mapping. Independent normal-polynomial and zlib oracles agree; literal123456789 gives2639f4cb wire bytes.",
  "boundary": {
    "input": "8-bit valid/ready bytes: two sequence/reserved bytes, TLP, four LCRC bytes; SOP/EOP plus upstream error",
    "max_tlp_dwords": 8,
    "complete_packet_buffered_before_output": true,
    "crc_residue": "debb20e3",
    "sequence_validation": false,
    "metadata_valid_at": "packet_good_o only; not an APB/completion tag",
    "header_big_endian": true,
    "payload_little_endian": true,
    "tx": "Existing DWORD completion stream, no outgoing sequence or LCRC",
    "soc_top_integrated": false
  },
