root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[{*.yaml,*.yml,*.json}]
indent_style = space
indent_size = 2

[{Makefile,Makefile.*,*.mk}]
indent_style = tab

# No automatic whitespace trimming: historical/frozen evidence is preserved.
