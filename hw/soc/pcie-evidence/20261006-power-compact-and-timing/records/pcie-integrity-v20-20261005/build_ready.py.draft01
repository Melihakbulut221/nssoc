"""Finite V20 measured candidate; preserve all three historical failures."""
from pathlib import Path
import datetime,hashlib,json
R=Path.cwd();B=Path(__file__).resolve().parent
def pin(p):
 with p.open('rb')as f:return dict(bytes=p.stat().st_size,sha256=hashlib.file_digest(f,'sha256').hexdigest())
releases=[]
for name,count in [('initial-failure-release01.json',2),('controls04-publication.json',4),('native-release01.json',2)]:
 p=B/name;r=json.loads(p.read_text());assert r['status']=='PASS_IMMUTABLE_RELEASE_ROUNDTRIPS'and len(r['assets'])==count
 for row,asset in zip(r['files'],r['assets'],strict=True):
  assert asset['authenticated_roundtrip']and asset['anonymous_roundtrip']
  assert pin(Path(row['path']))=={k:row[k]for k in ['bytes','sha256']}
  assert all(row[k]==asset[k]for k in ['name','bytes','sha256'])
 releases.append(r)
freeze=json.loads((B/'source-freeze04.json').read_text());controls=json.loads((B/'pcie-integrity-v20-core-controls-validation-20261005.json').read_text());decision=json.loads((B/'candidate-decision.json').read_text());native=json.loads((B/'pcie-integrity-v20-native-validation-20261005.json').read_text())
for path,value in freeze['files'].items():assert pin(R/path)==value
assert controls['status']=='PASS_ELIGIBLE_ROOT_RETIRE_AND_ACTUAL_PUBLIC_FAULT_CONTROLS'and controls['historical_failed_executions']==3
assert json.loads((B/'continuation-status04.json').read_text())['status']=='COMPLETE_NATIVE_SCREEN_FINITE_REVIEW_AND_PUBLICATION_REQUIRED'
files={str(p.relative_to(R)):pin(p)for p in B.rglob('*')if p.is_file()and not p.is_symlink()and '__pycache__'not in p.parts and p.name not in ['active-checkpoint.json','ready-finite.json','build-ready.log']}
r=dict(status='READY_V20_MEASURED_NATIVE_CANDIDATE_NOT_ADOPTED',utc=datetime.datetime.now(datetime.UTC).isoformat(),source_allowlist=[dict(repository_path=p,**v)for p,v in freeze['files'].items()],controls={k:controls[k]for k in ['pytest_executions','pytest_passed_executions','historical_failed_executions','original_selected_tests_covered','distinct_original_predicates','positive_public_cases_current_coverage','actual_RTL_mutants','literal_random_cases','literal_fourstate_local_cases','selected_XZ_cases','isolated_sensitivity_cases','excluded_MAX4118_ids','pytest_skipped','targeted_cocotb_intentionally_unselected']},functional_source_peer=pin(B/'source-only-peer-rx04.json'),merged_and_lifecycle_peer=pin(B/'native-source-only-peer04.json'),native_source_bridge=pin(B/'native-source-bridge04.json'),native=dict(mapped_cells=native['native_cell_count'],flops=native['flops'],limit_bytes=2*1024**3,CPU6=True,profile_ns=4,setup_ns=decision['setup_ns'],hold_ns=decision['hold_ns'],delta_vs_V17_ns=decision['delta_vs_V17'],delta_vs_V11_ns=decision['delta_vs_V11'],delta_vs_V19_ns=decision['delta_vs_V19'],import_cell_pin_bits=native['native_import_full_pin_proof']['checked_cell_pin_bits'],actual_import_graph_mutants=6),candidate_decision=pin(B/'candidate-decision.json'),releases={n:pin(B/n)for n in ['initial-failure-release01.json','controls04-publication.json','native-release01.json']},assets=[a for r in releases for a in r['assets']],evidence=files,stable_baseline='V11',adopted=False,physical_acceptance=False,scope='Only retirement empty-test moved from payloadkeep to knowneligibility read_any. Payload/writers/parser unchanged fromV19; exactinverse and finite fourstate/XZ/unknown/fault cases retained. 43 actualpytestexecutions=40PASS+3historicalFAIL; merged35selected/34distinct original predicates covered. First34PASS/1FAIL undetectedmutant retained; next2PASS2FAIL exposed onlymisalignedEDS in new15thcase. Finalalignedinverse/negative/direct15th/miter15th4PASS,56heldcycles55referenceemptyretirements; actualmutant ringdivergence48ns. Old14direct and14miter sourceidentical andPASS retained; no fabricated whole15 rerun. TwoMAX4118 excluded; targeted twoXML each14unselected recorded. All3failureexecutions andharnessdrafts preserved. Same2GiBCPU6 original4ns preplacementonly; no fullformal/mappedfunctionalreplay/place/CTS/route/RC/wholechipLVS/PHY/productionacceptance. V11 stablebaseline; measuredslacks/gains in exactdecision; pipeline alternative onlyconditionalplan, notimplemented.')
with(B/'ready-finite.json').open('x')as f:json.dump(r,f,indent=2);f.write('\n')
print(json.dumps(dict(ready=pin(B/'ready-finite.json'),sources=len(r['source_allowlist']),evidence=len(files),assets=len(r['assets']))))
