  "primary_sources": [
    {
      "url": "https://www.intel.com/content/dam/support/us/en/programmable/support-resources/fpga-wiki/asset03/pci-express-base-r2.1.pdf",
      "basis": "Historical Base2.1 sections3.3/3.4 and FC figure: three classes, Init1/Init2 exchange, cumulative credit fields and existing DLLP CRC convention. Indexed source; direct full-PDF retrieval was unavailable in prior source review; no Gen3 qualification inferred."
    },
    {
      "url": "https://cdrdv2-public.intel.com/655049/ug_pci_express.pdf",
      "basis": "Endpoints advertise infinite completion credits and must manage admission of outgoing nonposted requests against real completion capacity."
    },
    {
      "url": "https://www.intel.com/programmable/technical-pdfs/654304.pdf",
      "basis": "Endpoint completion credits are infinite while actual completion buffer capacity is finite; independent admission bookkeeping is necessary."
    }
  ],
  "implementation": {
    "top": "soc_pcie_buffered_flow_packets",
    "finite_classes": [
      "P",
      "NP"
    ],
    "slots_per_class": 2,
    "max_tlp_bytes": 32,
    "max_encoded_bytes": 38,
    "initial_header_credits_per_finite_class": 2,
    "initial_data_credits_per_finite_class": 4,
    "bytes_per_data_credit": 16,
    "separate_dllp_buffer_bytes": 6,
    "unadvertised_staging_bytes": 38,
    "cumulative_header_bits": 8,
    "cumulative_data_bits": 12,
    "completion_mode": "Infinite Cpl credit fields only in integrated completer-only mode; no outbound request input, requester_admission_o=0 and outstanding_requests_o=0. Unexpected inbound Cpl is discarded with sticky protocol/recovery notification.",
    "release": "Physical slot freed on actual downstream accepted/duplicate/rejected result. Only NEW accepted sequence increases cumulative allocated credits; sent snapshots change only at accepted FC EOP.",
    "init": "Actual P/NP/Cpl Init1 and Init2 triplets; local done requires completed local Init2 plus peer confirmation. RX eligibility after local Init2/peer initial classes permits TLP as confirmation alternative. Whole-frame fair FC versus ACK/TLP/replay arbitration.",
    "reset": "Link down or retrain_done restarts local sequence/credit/replay epoch; training pauses new frames and permits current frame to finish."
  },
  "tested": {
    "rtl_cases": 13,
    "native_cases": 13,
    "max_size_packets_in_rollover_case": 2050,
    "all_three_finite_classes": "Standalone queue component only; finite Cpl is not endpoint compliance.",
    "integrated": "Real LCRC/sequence/APB chain; ACK/NAK, no repeated write, CRC/future/malformed/oversize/no-credit-mint, unexpected-Cpl quarantine, DLLP bypass under pressure, init by TLP, stalls/reset/training."
  },
  "boundaries": {
    "standalone_only": true,
    "soc_top_modified_by_this_method": false,
    "full_pcie_controller_qualification": false,
    "phy_ltssm_pcs": false,
    "sdf_or_timing_closure": false,
    "formal_equivalence": false,
    "default_capacity": "32-byte TLP development boundary inherited from frozen endpoint. This does not establish minimum-MPS PCIe endpoint interoperability. Larger parameter settings have not been mapped/replayed by this capture.",
    "ingress": "Project-local ready/valid byte frames can backpressure; this does not establish a physical link ingress/elastic-buffer contract.",
    "timers": "FC refresh uses explicit project-clock cycles; no link-speed-calibrated update/init timing compliance is asserted.",
    "unsupported": "No requester admission/NP origination, VC>0, ECRC/TD, TLP prefixes or arbitrary completion handling.",
    "malformed": "Unsupported/oversize/structurally invalid frames are quarantined with recovery request; they are not claimed to receive all normative error-reporting behavior.",
    "native_diagnostics": "Unmodified IHP models report unsupported timing checks, and the installed cocotb/VVP launcher emits an executable-path diagnostic. All actual XML cases and native process statuses pass; no timing-check execution is claimed."
  }
}
