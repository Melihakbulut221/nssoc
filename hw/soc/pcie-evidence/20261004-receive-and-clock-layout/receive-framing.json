  "contract": {
    "top": "soc_pcie_gen3_framer_rx",
    "input": "Already deskewed/descrambled512-bit x4 payload plus each lane2-bit header and ready/valid/block_error",
    "external_control": "stream_start from external SDS/training owner; explicit abort for lost/truncated stream; no elapsed stall timeout",
    "output": "Complete byte packet with SOP/EOP/DLLP flag; TLP sequence restored with reserved zero upper nibble",
    "tokens": "STP CRC4/even parity/length; exact SDP/EDB/IDL; exact EDS only final DW",
    "quarantine": "TLP waits for validated immediate successor; exact EDB discards and pulses packet_nullified with sequence; malformed EDB or successor halts with no packet output",
    "successor": "Valid immediate STP/SDP/IDL/EDS retained during held prior packet then processed exactly once",
    "header_shape": "Normal3DW/4DW optional payload/digest header length agrees with STP length; no Prefix/PMUX",
    "capacity": [
      150,
      4118
    ],
    "maximum_digest_exclusion": "4122 encoded bytes for4096payload+4DW+digest do not fit4118",
    "metadata": "sequence meaningful for non-DLLP packet_good/nullified pulses; DLLP byte flag stable through held output",
    "recovery": "Framing error halts stream until fresh external start/reset/flush; exact EDS signals end and delegates OS handling"
  },
