  "contract": {
    "input": "8-bit complete encoded packets with accepted SOP/EOP/type/error/nullify flags",
    "tlp": "Two sequence-prefix bytes plus complete 3DW/4DW TLP optional payload/digest and caller-provided LCRC",
    "dllp": "Exactly six caller-provided DLLP bytes including CRC16",
    "output": "x4 full 64-symbol Data Blocks with header10, laneN gets symbol4k+N; zero IDL filling",
    "quarantine": "Complete packet shape validated before any packet block emission",
    "nullification": "Optional four C0 EDB symbols appended after complete supplied TLP/LCRC; STP length unchanged. Upstream sequence/LCRC nullification semantics are caller responsibility.",
    "capacity_default": 150,
    "capacity_maximum_rtl_tested": 4118,
    "maximum_digest_limitation": "4096-byte payload plus 4DW header plus digest plus LCRC and sequence totals4122 bytes and is rejected by the maximum4118 buffer.",
    "idle": "Continuous full IDL Data Blocks; registered output remains stable under stalls",
    "wrapper": "Optional frozen TXv3 scrambler/gearbox with all-byte advance/scrambling and no reseed"
  },
