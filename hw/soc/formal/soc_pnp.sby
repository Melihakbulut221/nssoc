[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12
timeout 120

[engines]
prove: abc pdr
~prove: smtbmc yices

[script]
read_verilog soc_pnp.v soc_apb_pnp.v
read_verilog -formal soc_pnp_props.v
prep -top soc_pnp_props -flatten
async2sync
dffunmap

[files]
../rtl/soc_pnp.v
../rtl/soc_apb_pnp.v
../rtl/soc_pnp_rom.vh
../rtl/soc_apb_pnp_rom.vh
soc_pnp_props.v
