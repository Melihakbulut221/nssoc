[tasks]
bmc
prove
cover
[options]
bmc: mode bmc
bmc: depth 32
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40
timeout 300
[engines]
prove: abc pdr
~prove: smtbmc yices
[script]
read_verilog -sv soc_pcie_tlp_regs.v soc_pcie_tlp_stream.v
read_verilog -formal soc_pcie_tlp_stream_props.v
prep -top soc_pcie_tlp_stream_props -flatten
async2sync
dffunmap
[files]
../rtl/pcie/soc_pcie_tlp_regs.v
../rtl/pcie/soc_pcie_tlp_stream.v
soc_pcie_tlp_stream_props.v
