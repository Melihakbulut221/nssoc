[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 200
~cover: timeout 300
cover: timeout 1200

[engines]
prove: abc pdr
~prove: smtbmc yices

[script]
read_verilog soc_uart.v
read_verilog -formal soc_uart_props.v
prep -top soc_uart_props -flatten
async2sync
dffunmap

[files]
../rtl/soc_uart.v
soc_uart_props.v
