SIM ?= icarus
TOPLEVEL_LANG = verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
BENCH := $(abspath $(dir $(THIS_MK)))
ROOT := $(abspath $(BENCH)/../../../..)
VENV_BIN := $(if $(wildcard $(ROOT)/hw/.venv/bin/cocotb-config),$(ROOT)/hw/.venv/bin,$(ROOT)/hw/soc/tools/cocotb-venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
PCIE_PYTHON := $(shell cocotb-config --python-bin)
export PYTHONPATH := $(BENCH):$(shell "$(PCIE_PYTHON)" -c 'import os,sys; print(os.pathsep.join(sys.path))')
RTL := $(ROOT)/hw/soc/rtl/pcie
VERILOG_SOURCES ?= $(RTL)/soc_pcie_crc16_byte.v $(RTL)/soc_pcie_acknak_tx.v $(RTL)/soc_pcie_packet_tx.v $(RTL)/soc_pcie_crc32_byte.v $(RTL)/soc_pcie_lcrc_rx.v $(RTL)/soc_pcie_sequence_rx.v $(RTL)/soc_pcie_lcrc_tx.v $(RTL)/soc_pcie_packet_endpoint.v $(RTL)/soc_pcie_tlp_stream.v $(RTL)/soc_pcie_tlp_regs.v $(RTL)/soc_pcie_link_packets.v $(RTL)/soc_pcie_dllp_rx.v $(RTL)/soc_pcie_replay_tx.v $(RTL)/soc_pcie_reliable_packets.v $(RTL)/soc_pcie_credit_tx.v $(RTL)/soc_pcie_flow_packets.v
TOPLEVEL = soc_pcie_flow_packets
COCOTB_TEST_MODULES = test_soc_pcie_flow_packets
COMPILE_ARGS += -g2012
ifeq ($(PCIE_NATIVE),1)
COMPILE_ARGS += -gspecify
endif
SIM_BUILD ?= sim_build_soc_pcie_flow_packets
COCOTB_RESULTS_FILE ?= results_soc_pcie_flow_packets.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
