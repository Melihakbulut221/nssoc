SIM ?= icarus
TOPLEVEL_LANG = verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
BENCH := $(abspath $(dir $(THIS_MK)))
ROOT := $(abspath $(BENCH)/../../../..)
VENV_BIN := $(if $(wildcard $(ROOT)/hw/.venv/bin/cocotb-config),$(ROOT)/hw/.venv/bin,$(ROOT)/hw/soc/tools/cocotb-venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
PCIE_PYTHON := $(shell cocotb-config --python-bin)
export PYTHONPATH := $(BENCH):$(shell "$(PCIE_PYTHON)" -c 'import os,sys; print(os.pathsep.join(sys.path))')
RTL := $(ROOT)/hw/soc/rtl/pcie
MODULES := soc_pcie_gen3_stp soc_pcie_gen3_framer_tx soc_pcie_gen3_packet_tx_path soc_pcie_gen3_tx_path_v3 soc_pcie_gen3_gearbox soc_pcie_gen3_scrambler soc_pcie_gen3_framer_rx soc_pcie_gen3_packet_rx_path soc_pcie_gen3_packet_duplex
VERILOG_SOURCES ?= $(addprefix $(RTL)/,$(addsuffix .v,$(MODULES)))
TOPLEVEL = soc_pcie_gen3_packet_duplex
COCOTB_TEST_MODULES = test_soc_pcie_gen3_packet_duplex
COMPILE_ARGS += -g2012
ifeq ($(PCIE_NATIVE),1)
COMPILE_ARGS += -gspecify
endif
SIM_BUILD ?= sim_build_soc_pcie_gen3_packet_duplex
COCOTB_RESULTS_FILE ?= results_soc_pcie_gen3_packet_duplex.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
