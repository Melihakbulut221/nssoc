SIM ?= icarus
TOPLEVEL_LANG = verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
VENV_BIN := $(abspath $(dir $(THIS_MK))/../../../.venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
VERILOG_SOURCES = $(abspath ../../rtl/soc_tmr_bank.v) $(abspath ../../../rtl/tmr_voter.v) $(PWD)/tb_soc_tmr_bank.v
TOPLEVEL = tb_soc_tmr_bank
COCOTB_TEST_MODULES = test_soc_tmr_bank
SIM_BUILD ?= sim_build_soc_tmr_bank
COCOTB_RESULTS_FILE ?= results_soc_tmr_bank.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
