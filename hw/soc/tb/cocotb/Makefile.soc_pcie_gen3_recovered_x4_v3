SIM ?= icarus
TOPLEVEL_LANG=verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
BENCH := $(abspath $(dir $(THIS_MK)))
ROOT := $(abspath $(BENCH)/../../../..)
VENV_BIN := $(if $(wildcard $(ROOT)/hw/.venv/bin/cocotb-config),$(ROOT)/hw/.venv/bin,$(ROOT)/hw/soc/tools/cocotb-venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
PCIE_PYTHON := $(shell cocotb-config --python-bin)
export PYTHONPATH := $(BENCH):$(shell "$(PCIE_PYTHON)" -c 'import os,sys;print(os.pathsep.join(sys.path))')
RTL := $(ROOT)/hw/soc/rtl/pcie
VERILOG_SOURCES ?= $(RTL)/soc_pcie_gen3_recovered_x4_v3.v $(RTL)/soc_pcie_gen3_lane_align_v3.v $(RTL)/soc_pcie_gen3_block_cdc_v1.v $(RTL)/soc_pcie_gen3_sds_deskew_v1.v $(RTL)/soc_pcie_gen3_record_descrambler_v1.v $(ROOT)/hw/soc/ext/verilog-ethernet/lib/axis/rtl/axis_async_fifo.v
TOPLEVEL=soc_pcie_gen3_recovered_x4_v3
COCOTB_TEST_MODULES=test_soc_pcie_gen3_recovered_x4_v3
DEPTH ?= 32
export RX_DEPTH := $(DEPTH)
COMPILE_ARGS += -g2012 -Psoc_pcie_gen3_recovered_x4_v3.FIFO_DEPTH=$(DEPTH)
SIM_BUILD ?= sim_build_soc_pcie_gen3_recovered_x4_v3
COCOTB_RESULTS_FILE ?= results_soc_pcie_gen3_recovered_x4_v3.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
