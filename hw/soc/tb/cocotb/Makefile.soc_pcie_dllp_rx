SIM ?= icarus
TOPLEVEL_LANG = verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
BENCH := $(abspath $(dir $(THIS_MK)))
ROOT := $(abspath $(BENCH)/../../../..)
PORTABLE_VENV := $(ROOT)/hw/.venv/bin
VENV_BIN := $(if $(wildcard $(PORTABLE_VENV)/cocotb-config),$(PORTABLE_VENV),$(ROOT)/hw/soc/tools/cocotb-venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
PCIE_PYTHON := $(shell cocotb-config --python-bin)
# Preserve this interpreter across the OSS CAD Suite vvp launcher's PYTHONHOME.
export PYTHONPATH := $(BENCH):$(shell "$(PCIE_PYTHON)" -c 'import os,sys; print(os.pathsep.join(sys.path))')
RTL := $(ROOT)/hw/soc/rtl/pcie
VERILOG_SOURCES ?= $(RTL)/soc_pcie_crc16_byte.v $(RTL)/soc_pcie_dllp_rx.v
TOPLEVEL = soc_pcie_dllp_rx
COCOTB_TEST_MODULES = test_soc_pcie_dllp_rx
COMPILE_ARGS += -g2012
ifeq ($(PCIE_NATIVE),1)
COMPILE_ARGS += -gspecify
endif
SIM_BUILD ?= sim_build_soc_pcie_dllp_rx
COCOTB_RESULTS_FILE ?= results_soc_pcie_dllp_rx.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
