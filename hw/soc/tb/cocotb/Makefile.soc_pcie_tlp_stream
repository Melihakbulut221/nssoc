SIM ?= icarus
TOPLEVEL_LANG = verilog
THIS_MK := $(lastword $(MAKEFILE_LIST))
VENV_BIN := $(abspath $(dir $(THIS_MK))/../../../.venv/bin)
ifeq ($(shell command -v cocotb-config 2>/dev/null),)
GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@
else
# Preserve the cocotb interpreter's stdlib/site-packages when OSS CAD Suite's
# vvp launcher replaces PYTHONHOME with its bundled Python installation.
PCIE_PYTHON := $(shell cocotb-config --python-bin)
export PYTHONPATH := $(shell "$(PCIE_PYTHON)" -c 'import os,sys; print(os.pathsep.join(sys.path))')
RTL := $(abspath $(dir $(THIS_MK))/../../rtl)
VERILOG_SOURCES = $(RTL)/pcie/soc_pcie_tlp_regs.v $(RTL)/pcie/soc_pcie_tlp_stream.v
TOPLEVEL = soc_pcie_tlp_stream
MODULE = test_soc_pcie_tlp_stream
PCIE_APB_TIMEOUT ?= 8
export PCIE_APB_TIMEOUT
COMPILE_ARGS += -Psoc_pcie_tlp_stream.VENDOR_ID=4660 -Psoc_pcie_tlp_stream.DEVICE_ID=22136 -Psoc_pcie_tlp_stream.APB_TIMEOUT=$(PCIE_APB_TIMEOUT)
SIM_BUILD ?= sim_build_soc_pcie_tlp_stream
COCOTB_RESULTS_FILE ?= results_soc_pcie_tlp_stream.xml
export COCOTB_RESULTS_FILE
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
