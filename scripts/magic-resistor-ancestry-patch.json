  "extra_payload_text": "\n/* Value ancestry observations only. No topology or resistor object mutation. */\nvoid ResPhysicalTraceReduction(const char *kind, const char *phase,\n        const resResistor *first, const resResistor *second,\n        const resResistor *third)\n{\n    const resResistor *members[3];\n    int i, count = 0;\n    if (mrpEpoch == 0 || !mrpStart(\"reduction\")) return;\n    members[0] = first; members[1] = second; members[2] = third;\n    fprintf(mrpFile, \",\\\"kind\\\":\\\"%s\\\",\\\"phase\\\":\\\"%s\\\",\\\"members\\\":[\",\n            kind, phase);\n    for (i = 0; i < 3; i++)\n    {\n        if (members[i] == NULL) continue;\n        if (count++) fputc(',', mrpFile);\n        fprintf(mrpFile, \"{\\\"slot\\\":%d\", i);\n        mrpResistor(members[i]);\n        fputc('}', mrpFile);\n    }\n    fputs(\"],\\\"physical_ownership_proved\\\":false\", mrpFile);\n    mrpFinish();\n}\nvoid ResPhysicalTraceDelete(const resResistor *resistor)\n{\n    /* Endpoints may already have been cleaned by the native caller.\n     * Observe only scalar fields that are alive until freeMagic below. */\n    if (mrpEpoch == 0 || !mrpStart(\"delete_resistor\")) return;\n    fprintf(mrpFile, \",\\\"resistor_address\\\":\\\"%p\\\",\"\n            \"\\\"deleted_value_milliohms_hex\\\":\\\"%a\\\"\",\n            (const void *)resistor, (double)resistor->rr_value);\n    mrpFinish();\n}\n",
