  "reset_contract": {
    "assertion": "Either clean reset-quality request or POR resets both domains and masks all public traffic asynchronously.",
    "release": "Exact three local release flops, four boot clocks and two peer-ready flops. A stopped clock prevents startup after reset; no mid-epoch clock-loss detection.",
    "collector_reset": "Frozen collector reset is internal CDC wr_running, before the public one-edge source_armed gate.",
    "epoch": "No new counter. Reset or synchronized fault invalidates pending downstream state. Already retired valid prefix may precede fault visibility.",
    "flush": "Discard raw32 residue, decoder pending batch, partial16-symbol record, two collector records, FIFO memory/prefetch output.",
    "polarity": "Must settle while reset/startup. A change in a running epoch becomes sticky loss and requires coordinated reset; no implicit polarity detection.",
    "arming": "After internal CDC running releases collector reset, one recovered edge settles initial polarity. Only then public recovered_running admits raw_valid."
  },
  "loss_contract": {
    "source": "Never backpressure the actual serial source. A complete record presented while the CDC cannot accept faults the epoch; collector ready equals actual acceptance.",
    "causes": [
      "Explicit recovered-domain loss",
      "Collector overflow",
      "In-epoch polarity change",
      "CDC capacity rejection"
    ],
    "fault_crossing": "Held bit through two common-clock flops; valid prefix can retire before visibility, then no later records until reset.",
    "classification": "Code/disparity errors and internal COM bits are payload evidence, not CDC fault or TS acceptance.",
    "startup": "Raw traffic while startup/reset/fault is not admitted; owner must arrange reacquisition after running.",
    "mid_epoch_clock_pause": "Writer pause permits queued prefix to drain without automatic fault. Reader pause permits finite backlog then capacity rejection. External owner loss must be held until sampled or coordinated reset asserted."
  },
