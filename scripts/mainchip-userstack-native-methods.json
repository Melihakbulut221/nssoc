s sent to OpenROAD.\n        child.terminate()\n        try:rc=child.wait(timeout=10)\n        except subprocess.TimeoutExpired:child.kill();rc=child.wait()\n    PROBE['stream'].close()\n    info=dict(returncode=rc,diagnostic_only=True,target_modified=False)\n    if(folder/'result.json').exists():\n        info['report']=json.loads((folder/'result.json').read_text())\n        info['report_sha256']=sha(folder/'result.json')\n    else:info['missing_report']=True\n    r['read_only_observer_finished']=info\ndef validate_observations():\n    assert PROBE is not None\n    folder=PROBE['folder'];report=json.loads((folder/'result.json').read_text())\n    assert report['status']=='COMPLETED_BOUND_READ_ONLY_OBSERVATIONS' and report['stop_requested']\n    rows=[json.loads(line)for line in(folder/'samples.jsonl').read_text().splitlines()]\n    assert len(rows)==report['observations'] and len(rows)>=3\n    assert sha(folder/'samples.jsonl')==report['samples_sha256']\n    assert [x['index']for x in rows]==list(range(len(rows)))\n    assert all(x['status']=='BOUND_READ_ONLY_SAMPLE'for x in rows)\n    assert all(x['sample']['derived']['identity']==report['identity']for x in rows)\n    return dict(samples=len(rows),samples_sha256=report['samples_sha256'],identity=report['identity'],\n        first_monotonic_ns=rows[0]['monotonic_begin_ns'],last_monotonic_ns=rows[-1]['monotonic_end_ns'],\n        last_cpu_comparison=rows[-1]['sample']['derived'].get('between_samples'),\n        cpu_motion_is_not_route_progress=True,route_progress_accepted=False)\n",
