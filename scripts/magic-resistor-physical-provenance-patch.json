      "position": "before",
      "insertion": "/* Optional diagnostic sidecar; native resistor structures are unchanged. */\nextern void ResPhysicalTraceBegin(const char *, const char *);\nextern void ResPhysicalTraceEnd(void);\nextern void ResPhysicalTraceTile(const resResistor *, const Tile *,\n        const Breakpoint *, const Breakpoint *, const char *);\nextern void ResPhysicalTraceContact(const resResistor *, const ResContactPoint *,\n        int, int, int, int, int, int, int, int);\nextern void ResPhysicalTraceSnapshot(const char *, const resResistor *);\nextern void ResPhysicalTraceOutput(const resResistor *, const char *);\nextern void ResPhysicalTraceOrphan(const char *, const char *);\n\n"
    },
    {
      "path": "resis/ResPrint.c",
      "anchor": "#define KV_TO_mV\t\t1000000\n",
      "position": "after",
      "payload": "scripts/magic_resistor_provenance_trace.inc"
    },
    {
      "path": "resis/ResMain.c",
      "anchor": "    ResNodeAtOrigin = NULL;\n",
      "position": "after",
      "insertion": "    ResPhysicalTraceBegin(node->name, cellname);\n"
    },
    {
      "path": "resis/ResMain.c",
      "anchor": "    /* Check integrity of internal database. Free up lists. */",
      "position": "before",
      "insertion": "    ResPhysicalTraceEnd();\n\n"
    },
    {
      "path": "resis/ResMakeRes.c",
      "anchor": "\t    resistor->rr_float.rr_area = 0;\n\n\t    freeMagic((char *)p1);",
      "position": "before",
      "insertion": "\t    ResPhysicalTraceTile(resistor, tile, p1, p2, \"east_west\");\n"
    },
    {
      "path": "resis/ResMakeRes.c",
      "anchor": "\t    resistor->rr_float.rr_area = 0;\n\t    freeMagic((char *)p1);",
      "position": "before",
      "insertion": "\t    ResPhysicalTraceTile(resistor, tile, p1, p2, \"north_south\");\n"
    },
    {
      "path": "resis/ResMakeRes.c",
      "anchor": "\t\tresistor->rr_status = 0;\n",
      "position": "after",
      "insertion": "\t\tResPhysicalTraceContact(resistor, contact, tilenum, minside,\n\t\t        viawidth, spacing, border, cscale, squaresx, squaresy);\n"
    },
    {
      "path": "resis/ResRex.c",
      "anchor": "\t    ResDoSimplify(ftolerance, resisdata);\n",
      "position": "before",
      "insertion": "\t    ResPhysicalTraceSnapshot(\"before_simplify\", ResResList);\n"
    },
    {
      "path": "resis/ResRex.c",
      "anchor": "\t    ResDoSimplify(ftolerance, resisdata);\n",
      "position": "after",
      "insertion": "\t    ResPhysicalTraceSnapshot(\"after_simplify\", ResResList);\n"
    },
    {
      "path": "resis/ResPrint.c",
      "anchor": "\t\t    resistors->rr_value / (float)ExtCurStyle->exts_resistScale);\n",
      "position": "after",
      "insertion": "\t    ResPhysicalTraceOutput(resistors, nodename);\n"
    },
    {
      "path": "resis/ResPrint.c",
      "anchor": "\tfprintf(outextfile, \"resist \\\"%s\\\" \\\"%s\\\" 0.0\\n\",\n\t\tnode->name, nodelist->rn_name);\n",
      "position": "after",
      "insertion": "\tResPhysicalTraceOrphan(node->name, nodelist->rn_name);\n"
    }
